{
  "policy": {
    "description": "Tiers hot-warm-cold para indices archivos-* (rollover por tamano/edad). Las edades son valores v1: se calibran en Fase 7.",
    "default_state": "hot",
    "ism_template": [
      {
        "index_patterns": ["archivos-*"],
        "priority": 100
      }
    ],
    "states": [
      {
        "name": "hot",
        "actions": [
          {
            "rollover": {
              "min_size": "30gb",
              "min_index_age": "30d"
            }
          }
        ],
        "transitions": [
          {
            "state_name": "warm",
            "conditions": { "min_index_age": "30d" }
          }
        ]
      },
      {
        "name": "warm",
        "actions": [
          {
            "replica_count": { "number_of_replicas": 1 }
          }
        ],
        "transitions": [
          {
            "state_name": "cold",
            "conditions": { "min_index_age": "180d" }
          }
        ]
      },
      {
        "name": "cold",
        "actions": [
          {
            "read_only": {}
          }
        ],
        "transitions": []
      }
    ]
  }
}
