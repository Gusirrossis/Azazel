# Entorno de PRODUCCIÓN para docker-compose.prod.yml.
#   cp deploy/.env.prod.ejemplo .env.prod && $EDITOR .env.prod
#
# El compose usa `${VAR:?...}` en todo lo sensible: si falta algo, NO arranca. Es
# deliberado — un default como `norm/norm` se queda puesto para siempre.
#
# ⚠️ Este archivo lleva secretos: NO se commitea (.gitignore) y sus permisos deben
#    ser 600. Rotar una clave = cambiarla aquí y `docker compose up -d`.

# ------------------------------------------------------------------ ⚙K16 topología
# QUÉ es este nodo. Sin esto el compose no arranca, a propósito: un VPS que
# arrancara como `local` se creería archivo maestro y ofrecería selector de
# destino, que son justo las dos cosas que no debe ser.
#   local             → todo en una máquina
#   hibrido-ingesta   → la Mac: discos físicos, archivo maestro
#   hibrido-servicio  → el VPS: fuentes de red, entidades, API pública
NORM_DESPLIEGUE__PERFIL=hibrido-servicio
NORM_DESPLIEGUE__NODO_ID=vps-01

# ------------------------------------------------------------------ secretos
NORM_PG_USER=norm
NORM_PG_PASSWORD=          # openssl rand -base64 32
NORM_PG_DB=normalizacion

NORM_OS_ADMIN_PASSWORD=    # OpenSearch 2.x exige mayúscula, minúscula, dígito y símbolo
NORM_OS_HEAP=4g            # ~la mitad de la RAM del contenedor; el resto, page cache
#
# El compose deriva de NORM_OS_ADMIN_PASSWORD las credenciales que usa el cliente
# (NORM_OPENSEARCH_USUARIO=admin / NORM_OPENSEARCH_PASSWORD) y activa TLS por el
# esquema https:// de la URL. En producción el plugin de seguridad está ACTIVO —a
# diferencia del compose .dev, que lo desactiva—: sin credenciales, la búsqueda, el
# sink y el backfill fallan reportando solo "OpenSearch no responde".

NORM_MINIO_ROOT_USER=norm
NORM_MINIO_ROOT_PASSWORD=  # openssl rand -base64 32

NORM_GRAFANA_PASSWORD=

# ------------------------------------------------------------------ API pública
# Llaves de MÁQUINA (reddoor, el AEB): consumidores sin navegador ni cookies. Las
# PERSONAS entran al panel con usuario y contraseña (`norm usuarios crear`).
#
# Estas llaves entran con rol admin: es el acceso de emergencia para cuando nadie
# puede entrar por el panel. Las claves CON NOMBRE que se generan desde la pestaña
# Acceso entran solo como lector, que es lo que necesita un consumidor externo.
#
# Sin NINGUNA llave y sin NINGÚN usuario la API queda abierta a cualquiera, para
# poder dar de alta al primer admin. Se cierra sola en cuanto existe uno.
# Formato: lista JSON.
NORM_API_KEYS=["cambia-esta-llave"]
NORM_API_CORS_ORIGENES=["https://tu-dominio.example"]

NORM_DOMINIO=tu-dominio.example   # Caddy emite el certificado para este nombre

# ------------------------------------------------------------------ datos
# Carpeta de origen montada solo-lectura dentro del contenedor como /datos.
NORM_CARPETA_DATOS=/srv/azazel/datos

# RAM dedicada: en un VPS la política `conservador` (40 % reservado) dejaría al
# gobernador con presupuesto para UN worker. Ver PLAN_TOPOLOGIA.md.
NORM_RECURSOS__POLITICA=maximo

# ------------------------------------------------------ sesión del panel (login)
# Caducidad por INACTIVIDAD: cada petición renueva la ventana. 720 min = 12 h.
NORM_SESION_DURACION_MIN=720
# `Secure` exige HTTPS. En producción SIEMPRE true: con Caddy delante hay TLS, y
# en false la cookie de sesión podría viajar en claro.
NORM_SESION_COOKIE_SECURE=true
# `strict` cierra el CSRF sin token aparte (el panel no se enlaza desde fuera).
NORM_SESION_COOKIE_SAMESITE=strict
# Fallos seguidos antes de frenar el login, y cuánto dura el freno (segundos).
NORM_LOGIN_MAX_INTENTOS=5
NORM_LOGIN_BLOQUEO_SEG=300

# ------------------------------------------------------- OCR y extracción de texto
# Interruptor general. Con `false` las imágenes van a frío (reversible) y los PDFs
# escaneados se indexan sin texto.
NORM_FILTRO__OCR_ACTIVO=true

# Qué imágenes merecen OCR:
#   escaneo  → solo lo que PARECE documento (recomendado). El clasificador mira
#              aspecto, saturación y proporción de blanco antes de gastar nada.
#   todas    → toda imagen, sin filtrar. Una pasada exhaustiva y cara.
#   ninguna  → OCR solo en PDFs escaneados, nunca en image/*.
NORM_FILTRO__OCR_POLITICA_IMAGEN=escaneo
# px: por debajo, una imagen es un ícono o una miniatura, no un documento.
NORM_FILTRO__IMAGEN_ANCHO_MIN_DOCUMENTO=600
# Confianza media (0-100) por debajo de la cual el texto OCR NO se indexa. Un texto
# inventado ensucia la búsqueda y mete anclas falsas en la resolución de entidades.
# El texto se conserva en la tabla `extracciones` para poder reextraerlo. 0 = no filtrar.
NORM_FILTRO__OCR_CONFIANZA_DESCARTE=40

# Preprocesado. Cada paso se puede apagar por separado para medir su aporte real
# con `norm calidad evaluar` en vez de suponerlo.
NORM_WORKER__OCR_IDIOMAS=spa+eng
NORM_WORKER__OCR_DESKEW=true          # endereza la página (OSD de Tesseract)
NORM_WORKER__OCR_BINARIZAR=true       # umbral de Otsu: separa tinta de papel
NORM_WORKER__OCR_PDF_ESCALA=4.2       # ≈300 dpi, donde Tesseract está calibrado
NORM_WORKER__OCR_PDF_MAX_PAGINAS=20
# Tiempo por archivo. El plazo es COOPERATIVO: al agotarse, el extractor devuelve
# las páginas que alcanzó en vez de perderlas. El corte duro va un 25% por encima.
NORM_WORKER__EXTRACTOR_TIMEOUT_S=300
