# Entorno de PRODUCCIÓN para docker-compose.prod.yml.
#   cp deploy/.env.prod.ejemplo .env.prod && $EDITOR .env.prod
#
# El compose usa `${VAR:?...}` en todo lo sensible: si falta algo, NO arranca. Es
# deliberado — un default como `norm/norm` se queda puesto para siempre.
#
# ⚠️ Este archivo lleva secretos: NO se commitea (.gitignore) y sus permisos deben
#    ser 600. Rotar una clave = cambiarla aquí y `docker compose up -d`.

# ------------------------------------------------------------------ ⚙K16 topología
# QUÉ es este nodo. Sin esto el compose no arranca, a propósito: un VPS que
# arrancara como `local` se creería archivo maestro y ofrecería selector de
# destino, que son justo las dos cosas que no debe ser.
#   local             → todo en una máquina
#   hibrido-ingesta   → la Mac: discos físicos, archivo maestro
#   hibrido-servicio  → el VPS: fuentes de red, entidades, API pública
NORM_DESPLIEGUE__PERFIL=hibrido-servicio
NORM_DESPLIEGUE__NODO_ID=vps-01

# ------------------------------------------------------------------ secretos
NORM_PG_USER=norm
NORM_PG_PASSWORD=          # openssl rand -base64 32
NORM_PG_DB=normalizacion

NORM_OS_ADMIN_PASSWORD=    # OpenSearch 2.x exige mayúscula, minúscula, dígito y símbolo
NORM_OS_HEAP=4g            # ~la mitad de la RAM del contenedor; el resto, page cache

NORM_MINIO_ROOT_USER=norm
NORM_MINIO_ROOT_PASSWORD=  # openssl rand -base64 32

NORM_GRAFANA_PASSWORD=

# ------------------------------------------------------------------ API pública
# Con la lista VACÍA la autenticación queda DESHABILITADA (`llave_valida` devuelve
# True) y el índice entero queda abierto. Formato: lista JSON.
NORM_API_KEYS=["cambia-esta-llave"]
NORM_API_CORS_ORIGENES=["https://tu-dominio.example"]

NORM_DOMINIO=tu-dominio.example   # Caddy emite el certificado para este nombre

# ------------------------------------------------------------------ datos
# Carpeta de origen montada solo-lectura dentro del contenedor como /datos.
NORM_CARPETA_DATOS=/srv/azazel/datos

# RAM dedicada: en un VPS la política `conservador` (40 % reservado) dejaría al
# gobernador con presupuesto para UN worker. Ver PLAN_TOPOLOGIA.md.
NORM_RECURSOS__POLITICA=maximo
