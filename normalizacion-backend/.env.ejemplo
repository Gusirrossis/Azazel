# Copia este archivo a `.env` y ajusta. TODO es sobreescribible por variable
# de entorno con el mismo nombre. Anidados usan __ (ej. NORM_FILTRO__UMBRAL_HOT=70).
#
# Este ejemplo es el del despliegue LOCAL (todo en una máquina), que es el default.
# Para el despliegue repartido ver `deploy/.env.prod.ejemplo` y PLAN_TOPOLOGIA.md.

# ------------------------------------------------------------- ⚙K16 topología
# QUÉ es este nodo. `local` (default) = todo en una máquina, el comportamiento de
# siempre. NO es editable en caliente: cambiar la topología con procesos vivos no
# es coherente, así que vive aquí y no en la tabla config_overrides.
#
#   local             → todo junto (default)
#   hibrido-ingesta   → nodo con los discos físicos; es el ARCHIVO MAESTRO
#   hibrido-servicio  → nodo con la API pública; resuelve entidades
#
# El `nodo_id` entra en identificadores PERMANENTES (disco_id de discos nuevos y
# nombre del índice de escritura). Elígelo una vez y no lo cambies.
# NORM_DESPLIEGUE__PERFIL=local
# NORM_DESPLIEGUE__NODO_ID=local

# ----------------------------------------------------------------- conexiones
NORM_POSTGRES_DSN=postgresql://norm:norm@localhost:5432/normalizacion
NORM_OPENSEARCH_URL=http://localhost:9200

# ------------------------------------------------- DESTINOS de lo procesado
# (1) ORIGINALES (HOT): los archivos útiles, íntegros, deduplicados por sha256.
# (2) FRÍO: lo descartado por el filtro — también se copia (reversible).
# (3) ÍNDICE: los METADATOS + texto buscable van a OpenSearch (no son archivos).
#
# Opción A — MinIO (default; igual que producción):
NORM_ALMACEN_BACKEND=minio
NORM_MINIO_ENDPOINT=localhost:9000
NORM_MINIO_ACCESS_KEY=norm
NORM_MINIO_SECRET_KEY=norm-secreto
NORM_MINIO_BUCKET=almacen
NORM_MINIO_BUCKET_FRIO=frio
#
# Opción B — carpetas locales del sistema (sin MinIO):
# NORM_ALMACEN_BACKEND=local
# NORM_ALMACEN_LOCAL_RAIZ=~/normalizacion/almacen
# NORM_ALMACEN_FRIO_LOCAL_RAIZ=~/normalizacion/frio

# ----------------------------------------------------------------- API (front)
# NORM_API_KEYS=["llave-1"]            # vacío = sin auth (solo dev)
# NORM_API_CORS_ORIGENES=["http://localhost:5173"]

# --------------------------------------------- destino elegible desde el front
# En Docker (perfil app): monta una carpeta escribible de tu equipo y el front
# permite ELEGIR ahi la carpeta de destino de cada indexacion (almacen + frio):
# NORM_CARPETA_DESTINO=C:\Users\Public\normalizacion-destino   (o /Users/tu/destino en Mac)
